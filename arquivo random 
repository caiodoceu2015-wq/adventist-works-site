const express = require("express");
const fs = require("fs");
const path = require("path");
const session = require("express-session");

const app = express();
const PORT = 3000;

// SENHA FIXA PARA O EXEMPLO
const ADMIN_PASSWORD = "234116";

// IMPORTANTE: em produção, use .env
const SESSION_SECRET = "troque-por-um-segredo-forte";

app.use(express.json({ limit: "2mb" }));
app.use(express.urlencoded({ extended: true }));

app.use(
  session({
    secret: SESSION_SECRET,
    resave: false,
    saveUninitialized: false,
    cookie: {
      httpOnly: true,
      sameSite: "lax",
      secure: false, // true em HTTPS
    },
  })
);

// Middleware de autenticação
function requireAuth(req, res, next) {
  if (req.session && req.session.admin === true) {
    return next();
  }
  return res.status(401).json({
    ok: false,
    message: "Acesso restrito. Faça login na área secreta.",
  });
}

// Login da área secreta
app.post("/api/login", (req, res) => {
  const { password } = req.body || {};

  if (password === ADMIN_PASSWORD) {
    req.session.admin = true;
    return res.json({
      ok: true,
      message: "Área secreta liberada.",
    });
  }

  return res.status(401).json({
    ok: false,
    message: "Senha incorreta.",
  });
});

// Logout
app.post("/api/logout", (req, res) => {
  req.session.destroy(() => {
    res.json({ ok: true, message: "Sessão encerrada." });
  });
});

// Status da sessão
app.get("/api/session", (req, res) => {
  if (req.session && req.session.admin === true) {
    return res.json({ ok: true, admin: true });
  }
  return res.json({ ok: false, admin: false });
});

// Área secreta do painel
app.get("/admin", requireAuth, (req, res) => {
  res.sendFile(path.join(__dirname, "admin.html"));
});

// Atualiza o script principal do jogo
app.post("/api/update-game-script", requireAuth, (req, res) => {
  const { script } = req.body || {};

  if (!script || typeof script !== "string") {
    return res.status(400).json({
      ok: false,
      message: "Script inválido.",
    });
  }

  const scriptPath = path.join(__dirname, "public", "game-script.js");

  try {
    fs.writeFileSync(scriptPath, script, "utf8");
    return res.json({
      ok: true,
      message: "Script do jogo atualizado com sucesso.",
      file: "public/game-script.js",
    });
  } catch (error) {
    return res.status(500).json({
      ok: false,
      message: "Erro ao atualizar o script.",
      error: error.message,
    });
  }
});

// Serve os arquivos públicos do jogo
app.use(express.static(path.join(__dirname, "public")));

// Página do jogo
app.get("/", (req, res) => {
  res.sendFile(path.join(__dirname, "public", "game.html"));
});

app.listen(PORT, () => {
  console.log(`Servidor online: http://localhost:${PORT}`);
  console.log(`Área secreta: http://localhost:${PORT}/admin`);
  console.log(`Senha do exemplo: ${ADMIN_PASSWORD}`);
});